[Unit]
Description=Avito Resale Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/avto-parser
ExecStart=/root/avto-parser/venv/bin/python3 -m bot.main
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Kill all child processes on stop (including Playwright)
KillMode=control-group
TimeoutStopSec=30

# Environment
Environment=PYTHONPATH=/root/avto-parser
Environment=PYTHONUNBUFFERED=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=avito-bot

[Install]
WantedBy=multi-user.target
